# railway.json — tells Railway how to run your backend
# Place this in the /backend folder
{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"       // Railway auto-detects Node.js and runs npm install
  },
  "deploy": {
    "startCommand": "npm start", // Runs: node src/server.js
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
